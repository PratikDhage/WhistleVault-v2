# Copy this file to .env for local development.
# NEVER commit your real .env file.

# --- Core ---
FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-value      # e.g. python -c "import secrets; print(secrets.token_hex(32))"

# --- Database (Render Postgres / Neon / Supabase all provide this URL) ---
# Example Neon:      postgresql://user:pass@ep-xxxx.us-east-2.aws.neon.tech/dbname
# Example Supabase:  postgresql://postgres:pass@db.xxxx.supabase.co:5432/postgres
DATABASE_URL=postgresql://user:password@host:5432/whistlevault

# --- Session cookies ---
SESSION_COOKIE_SECURE=true                        # set to false only for local http:// dev

# --- Admin account (change these before deploying publicly!) ---
ADMIN_USERNAME=admin
# Prefer a Werkzeug hash in production; do not store an admin password in source control.
ADMIN_PASSWORD_HASH=replace-with-werkzeug-password-hash

# --- OTP ---
OTP_EXPIRY_MINUTES=10

# --- AI (Groq) -- optional; leave blank to disable AI features entirely ---
# Get a free key at https://console.groq.com
GROQ_API_KEY=
# Check https://console.groq.com/docs/models for the current model list
# if this default has been retired.
GROQ_MODEL=openai/gpt-oss-20b

# --- Mail (set MAIL_PROVIDER=smtp to send real email) ---
MAIL_PROVIDER=console
MAIL_SERVER=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=apikey
MAIL_PASSWORD=your-smtp-password-or-api-key
MAIL_DEFAULT_SENDER=no-reply@yourdomain.com
MAIL_TIMEOUT_SECONDS=8

# --- Uploads / storage ---
STORAGE_BACKEND=s3                                  # s3 is required for durable hosted media
MEDIA_FOLDER=./media                                # used only when STORAGE_BACKEND=local
# S3-compatible storage (AWS S3, Supabase Storage, Cloudflare R2, ...)
S3_BUCKET=
S3_REGION=                                          # Supabase: project region, if required by your project
S3_ENDPOINT=                                        # Supabase: https://PROJECT_REF.supabase.co/storage/v1/s3
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Rate limiting (use a shared Redis URL across instances in production) ---
RATELIMIT_STORAGE_URI=memory://
# RATELIMIT_STORAGE_URI=redis://user:pass@host:6379/0

# --- DB connection pool ---
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
